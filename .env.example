# cup-agent 配置样例
#
# 用法:复制为 .env 后按需填写。**什么都不配也能跑** —— 全部变量都有合理默认值,
# 下面标「必填」的只有生产环境才必须给。
#
#   cp .env.example .env
#
# 完整的含义、默认值与生产注意事项见 DEPLOY.md(环境变量一节)。
# 本文件只列变量名和一句话说明,便于快速对照。

# ─── 监听 ───────────────────────────────────────────────────────────
# 监听地址。默认 127.0.0.1(仅本机);容器内需 0.0.0.0。DEPLOY.md 已说明。
#CUP_HOST=127.0.0.1
#CUP_PORT=8788

# ─── 密钥(生产必填) ─────────────────────────────────────────────────
# 写端点的 x-api-key。不设则启动时随机生成,只能从启动横幅里捞。
#CUP_API_KEY=
# 绑定码哈希的 pepper(base64)。不设则自动生成到 .data/claim-pepper。
# 多副本或不想依赖卷时必须显式给同一份。
#CUP_CLAIM_PEPPER=
# 用户模型 key 的加密主钥(base64 32 字节)。不设则自动生成到 .data/llm-enc-key。
#CUP_LLM_ENC_KEY=

# ─── 存储 ───────────────────────────────────────────────────────────
# Postgres 连接串。不设则退内存/文件,重启丢数据(除 .data 里的)。
#CUP_PG_URL=postgres://user:pass@127.0.0.1:5432/cupdev
# 非 PG 状态(目标/对话/画像/社交)的落盘目录。
#CUP_DATA_DIR=./.data

# ─── 行为开关 ───────────────────────────────────────────────────────
# 绑定杯子须出示设备一次性 claim code。默认开;仅 0/false 关(生产勿关)。
#CUP_REQUIRE_CLAIM=1
# 人格市场灰度开关。默认关;1/true 开。
#CUP_MARKET_OPEN=0
# 启动时顺带清一次过期分区(不可逆,绝不隐式跑)。
#CUP_RETENTION=0

# ─── 模型(不配则用确定性模板,功能仍可用) ──────────────────────────
#CUP_LLM_URL=
#CUP_LLM_KEY=
#CUP_LLM_MODEL=
#CUP_CHAT_URL=
#CUP_CHAT_KEY=
#CUP_CHAT_MODEL=

# ─── MQTT(真机 ingest) ──────────────────────────────────────────────
#CUP_MQTT_URL=
# 多实例时每个必须不同,否则互相抢订阅。
#CUP_MQTT_CLIENT_ID=
#CUP_MQTT_HOST=
#CUP_MQTT_PORT=

# ─── 角色(注册那一刻按邮箱定一次,事后改名单不影响已注册账号) ──────
#CUP_ADMIN_EMAIL=
#CUP_OPS_EMAILS=a@x.com,b@x.com
#CUP_REVIEWER_EMAILS=c@x.com

# ─── 网络 / TLS / 时区 ──────────────────────────────────────────────
# 前后端不同域时必须列出来源,否则浏览器拦配置类请求。默认 *。
#CUP_CORS_ORIGINS=
# 两个都给才启用 https 并自动加 HSTS。只给一个启动即 fatal。
#CUP_TLS_CERT=
#CUP_TLS_KEY=
# 只在反向代理后面开。直连时开 = 客户端 IP 可伪造,限流会被绕过。
#CUP_TRUST_PROXY=0
# IANA 时区,影响日界与日志时间戳。
#CUP_TZ=Asia/Shanghai

# ─── 日志 ───────────────────────────────────────────────────────────
#CUP_LOG_LEVEL=info
#CUP_LOG_FORMAT=text
# JSONL 文件出口目录。不设则不落文件。
#CUP_LOG_DIR=
