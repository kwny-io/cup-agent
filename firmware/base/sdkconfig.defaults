# 底座默认配置(ESP32-S3)。idf.py set-target esp32s3 会用这份做初始值。
CONFIG_IDF_TARGET="esp32s3"

# 4MB flash / 单 app 分区 —— 最小 bring-up 够用。
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# Wi-Fi 省电:底座多插电、但称重待机也需省电,modem sleep 默认开。
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y

# 日志等级:默认 INFO,联调排障可临时调 DEBUG。
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 设备身份:共享 Kconfig(cup_common)的 device_id 默认是 lid- 前缀(杯盖用),
# 底座工程在此覆盖成 base- 前缀 —— 否则 topic/payload 的 device_id 会挂错正则。
# 真机请按实际机壳编号改;cup_id 必须与配对的杯盖一致。
CONFIG_CUP_DEVICE_ID="base-A1B2C3"
CONFIG_CUP_CUP_ID="cup-A1B2C3"
